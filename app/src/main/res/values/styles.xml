<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material Design 1 (Lollipop-style AppCompat theme) -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="alertDialogTheme">@style/AlertDialogTheme</item>
    </style>

    <style name="AlertDialogTheme" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="colorAccent">@color/primary</item>
    </style>

    <style name="FullScreenDialog" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:windowIsFloating">false</item>
    </style>

    <!-- Auth screens: dark card, Material 1 underline fields and raised buttons -->
    <style name="AuthOverlay" parent="ThemeOverlay.AppCompat.Dark">
        <item name="colorAccent">#D68A4C</item>
        <item name="colorControlActivated">#D68A4C</item>
        <item name="colorControlNormal">#AB9578</item>
        <item name="android:textColorHint">#AB9578</item>
    </style>

    <style name="AuthButton" parent="Widget.AppCompat.Button.Colored">
        <item name="android:textColor">#22190F</item>
        <item name="android:minHeight">44dp</item>
    </style>

    <style name="AuthFlatButton" parent="Widget.AppCompat.Button.Borderless.Colored">
        <item name="android:textColor">#D68A4C</item>
    </style>
</resources>
