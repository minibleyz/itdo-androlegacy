<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material Design 1 (Lollipop-style AppCompat theme) -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="alertDialogTheme">@style/AlertDialogTheme</item>
    </style>

    <style name="AlertDialogTheme" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="colorAccent">@color/primary</item>
    </style>

    <style name="FullScreenDialog" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:windowIsFloating">false</item>
    </style>

    <!-- Auth screens: dark card, Material 1 underline fields and raised buttons -->
    <style name="AuthOverlay" parent="ThemeOverlay.AppCompat.Dark">
        <item name="colorAccent">#D68A4C</item>
        <item name="colorControlActivated">#D68A4C</item>
        <item name="colorControlNormal">#AB9578</item>
        <item name="android:textColorHint">#AB9578</item>
    </style>

    <style name="AuthButton" parent="Widget.AppCompat.Button.Colored">
        <item name="android:textColor">#22190F</item>
        <item name="android:minHeight">44dp</item>
    </style>

    <style name="AuthFlatButton" parent="Widget.AppCompat.Button.Borderless.Colored">
        <item name="android:textColor">#D68A4C</item>
    </style>

    <!-- Used by the native screens added on top of the WebView (ITDO Pro perks list). -->
    <style name="ProPerk">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:text">•</item>
    </style>

    <!-- Top (leaderboard) tab -->
    <style name="TopTab">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">4dp</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">10dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Settings form -->
    <style name="SettingsLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="SettingsInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:background">@null</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingVertical">6dp</item>    </style>
</resources>
